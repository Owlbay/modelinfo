# 自托管：与 public/_headers、public/_redirects 保持一致。
# 使用 Cloudflare Tunnel / 代理时可改为 :80 并由 CF 终止 TLS。
{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	rewrite /v1/models /v1/models.json
	rewrite /v1/health /v1/meta.json
	rewrite /v1/meta /v1/meta.json
	@providerModels path_regexp provider ^/v1/providers/([^/]+)/models$
	rewrite @providerModels /v1/providers/{re.provider.1}/models.json

	@api path /v1/* /data/*
	header @api {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	}
	@v1 {
		path /v1/*
		not path /v1/meta.json
	}
	header @v1 Cache-Control "public, max-age=300, stale-while-revalidate=3600"
	header /v1/meta.json Cache-Control "public, max-age=60, must-revalidate"
	header /data/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
