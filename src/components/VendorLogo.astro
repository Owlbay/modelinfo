---
/**
 * 模型厂商 logo：@lobehub/icons-static-svg 单色图标（fill="currentColor"，随文字色适配深浅主题），
 * 构建时内联；未登记图标的厂商显示首字母方块。
 * sprite 为 true 时只输出 <use>，引用页面中 Sprites 组件生成的 symbol（长列表用，避免每行重复整段路径）。
 */
import { vendor } from '../lib/models';
import { vendorSvg } from '../lib/vendor-icons';

interface Props {
  id: string;
  size?: number;
  class?: string;
  sprite?: boolean;
}
const { id, size = 16, class: className, sprite = false } = Astro.props;
const v = vendor(id);
const icon = vendorSvg(id);
const svg = icon
  ? sprite
    ? `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"><use href="#${icon.symbol}"/></svg>`
    : `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" ${icon.attrs}>${icon.inner}</svg>`
  : null;
const initial = (v?.name ?? id).slice(0, 1).toUpperCase();
---

{
  svg ? (
    <span class:list={['vlogo', className]} set:html={svg} />
  ) : (
    <span class:list={['vlogo', 'vlogo--text', className]} style={`--vlogo-size:${size}px`} aria-hidden="true">
      {initial}
    </span>
  )
}

<style>
  .vlogo {
    display: inline-grid;
    flex: none;
    place-items: center;
    color: var(--ink);
  }
  .vlogo :global(svg) { display: block; }
  .vlogo--text {
    width: var(--vlogo-size);
    height: var(--vlogo-size);
    border: 1px solid var(--line-strong);
    font: 500 var(--fs-mono-xs) / 1 var(--font-mono);
    color: var(--ink-2);
  }
</style>
