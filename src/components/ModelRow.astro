---
/**
 * 模型列表行。默认显示 6 列（名称 · 模型厂商 · 上下文 · 输出 · 价格 · 发布）；
 * 外层 .models--full 时展开为全部字段，列宽由 ModelsView 按全部数据在构建时算出（--cols）。单元格文本见 src/lib/row.ts，骨架见 .list-row。
 * 厂商 logo 与模态图标引用页面中 Sprites 的 symbol。
 */
import { modelKind, ownerName, type Model } from '../lib/models';
import { rowCells } from '../lib/row';
import { dict, localePath, type Lang } from '../i18n';
import VendorLogo from './VendorLogo.astro';
import Modalities from './Modalities.astro';

interface Props {
  lang: Lang;
  model: Model;
}
const { lang, model: m } = Astro.props;
const d = dict(lang);
const c = rowCells(m, d);
---

<a class="list-row mrow" href={localePath(lang, `/models/${m.id}/`)} data-model data-owner={m.owned_by} data-kind={modelKind(m)} data-hay={[m.id, m.name, m.owned_by, ownerName(m.owned_by), ...m.aliases].join(' ').toLowerCase()}>
  <span class="mrow__main">
    <span class="mrow__name" title={m.name}>{m.name}</span>
    {m.info.status === 'retired' && <span class="mrow__tag">{d.model.status.retired}</span>}
    <span class="mrow__id">{m.id}</span>
  </span>
  <span class="mrow__owner"><VendorLogo id={m.owned_by} size={14} sprite /><span>{c.owner}</span></span>
  <span class="mrow__x">{c.kind}</span>
  <span class="mrow__x">{c.api}</span>
  <span class="mrow__num">{c.context}</span>
  <span class="mrow__num mrow__x">{c.input}</span>
  <span class="mrow__num mrow__out">{c.output}</span>
  <span class="mrow__x"><Modalities lang={lang} items={m.modalities.input} sprite /></span>
  <span class="mrow__x"><Modalities lang={lang} items={m.modalities.output} sprite /></span>
  <span class="mrow__x">{c.reasoning}</span>
  <span class="mrow__num mrow__price">
    {c.price}
  </span>
  <span class="mrow__num mrow__x">{c.cache}</span>
  <span class="mrow__x">{c.features}</span>
  <span class="mrow__x">{c.status}</span>
  <span class="mrow__date">{c.release}</span>
  <span class="mrow__date mrow__x">{c.cutoff}</span>
</a>

<style>
  /* 默认 6 列，按比例分配宽度；表头见 ModelsView，断点与之一致 */
  .mrow {
    grid-template-columns: minmax(0, 4fr) minmax(0, 1.6fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 2fr) minmax(0, 1.1fr);
    column-gap: var(--sp-5);
    color: var(--ink);
  }
  .mrow__x { display: none; }
  .mrow__main {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    min-width: 0;
  }
  .mrow__name {
    /* 名称优先占位，ID 先省略；名称超过整列时自身也省略，不撑宽行 */
    flex: none;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-sans);
    color: var(--ink);
  }
  /* 已下线标记：不删除记录，只在名称后标注 */
  .mrow__tag {
    flex: none;
    padding: 0 var(--sp-1);
    border: 1px solid var(--line-strong);
    font-size: var(--fs-mono-sm);
    line-height: var(--lh-mono-sm);
    color: var(--ink-3);
  }
  .mrow__id {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--fs-mono-sm);
    line-height: var(--lh-mono-sm);
    color: var(--ink-3);
  }
  .mrow__owner {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-width: 0;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .mrow__owner > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .mrow__num,
  .mrow__date { color: var(--ink-3); text-align: right; white-space: nowrap; }
  .mrow__price { color: var(--ink-2); }

  /* 离屏行跳过样式、排版与绘制（近千行时切换视图与筛选只计算可见区域）；auto 记住渲染过的真实高度 */
  .mrow { content-visibility: auto; contain-intrinsic-size: auto var(--row-h); }

  /* 展开：全部字段。列宽为 ModelsView 构建时算出的 --cols（固定宽度，各行一致、无需互相测量）；
     列间距算进列宽，单元格自带右内距；不换行，超出省略 */
  :global(.models--full) .mrow {
    grid-template-columns: var(--cols);
    column-gap: 0;
    align-items: center;
    width: max-content;
    min-width: 100%;
  }
  :global(.models--full) .mrow__x { display: block; }
  :global(.models--full) .mrow > span { padding-right: var(--sp-5); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  :global(.models--full) .mrow > span:not(.mrow__num):not(.mrow__date) { color: var(--ink-2); }
  /* 固定列：宽度就是本列宽度（含右侧间距），撑满整行高度；悬停时随行变色，横向滚动后右缘一条细线 */
  :global(.models--full) .mrow { --row-pad: 0px; }
  :global(.models--full) .mrow .mrow__main {
    position: sticky;
    left: 0;
    z-index: 1;
    align-self: stretch;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    margin-block: calc(-1 * var(--sp-3));
    padding-block: var(--sp-3);
    background: var(--bg);
  }
  :global(.models--full [data-scrolled]) .mrow .mrow__main { box-shadow: inset -1px 0 0 var(--line); }
  @media (hover: hover) {
    :global(.models--full) .mrow:hover .mrow__main { background: var(--hover-row-solid); }
  }
  /* 平板（默认视图）：去掉输出与发布日期，ID 让位给名称 */
  @media (max-width: 1024px) {
    .mrow { grid-template-columns: minmax(0, 3fr) minmax(0, 1.6fr) minmax(0, 0.9fr) minmax(0, 2fr); column-gap: var(--sp-4); }
    .mrow__out,
    .mrow__date,
    .mrow__id { display: none; }
    :global(.models--full) .mrow__out,
    :global(.models--full) .mrow__date,
    :global(.models--full) .mrow__id { display: block; }
  }
  /* 手机（默认视图）：名称一行，模型厂商 · 上下文 · 价格一行 */
  @media (max-width: 640px) {
    .mrow {
      grid-template-columns: auto auto minmax(0, 1fr);
      column-gap: var(--sp-3);
      row-gap: var(--sp-1);
    }
    .mrow__main { grid-column: 1 / -1; }
    .mrow__num { text-align: left; }
    /* 带单位的价格较长，窄屏允许换行，不撑宽行 */
    .mrow__price { text-align: right; white-space: normal; overflow-wrap: anywhere; }
    :global(.models--full) .mrow__main { grid-column: auto; }
  }
</style>
