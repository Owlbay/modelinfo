---
/** 模型列表行：名称/ID · 研发方 · 上下文 · 最大输出 · 输入/输出价格 · 发布日期。骨架见 .list-row。 */
import { formatPrice, formatTokens, modelKind, ownerName, type Model } from '../lib/models';
import { dict, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  model: Model;
}
const { lang, model: m } = Astro.props;
const p = m.pricing;
// 非 Token 计价时在价格后标注单位
const unit = p && p.unit !== '1M_tokens' ? ` / ${dict(lang).units[p.unit]}` : '';
---

<a class="list-row mrow" href={localePath(lang, `/models/${m.id}/`)} data-model data-owner={m.owned_by} data-kind={modelKind(m)} data-hay={[m.id, m.name, m.owned_by, ownerName(m.owned_by), ...m.aliases].join(' ').toLowerCase()}>
  <span class="mrow__main">
    <span class="mrow__name">{m.name}</span>
    <span class="mrow__id">{m.id}</span>
  </span>
  <span class="mrow__owner">{ownerName(m.owned_by)}</span>
  <span class="mrow__num">{formatTokens(m.limits.context)}</span>
  <span class="mrow__num mrow__out">{formatTokens(m.limits.output)}</span>
  <span class="mrow__num mrow__price">
    {p ? `${formatPrice(p.input, p.currency)} / ${formatPrice(p.output, p.currency)}${unit}` : '—'}
  </span>
  <span class="mrow__date">{m.info.release_date ?? '—'}</span>
</a>

<style>
  /* 列：名称 · 研发方 · 上下文 · 输出 · 价格 · 发布；表头见 ModelsView，断点与之一致 */
  .mrow {
    grid-template-columns: minmax(0, 1fr) 10ch 8ch 8ch 22ch 10ch;
    column-gap: var(--sp-5);
    color: var(--ink);
  }
  .mrow__main {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    min-width: 0;
  }
  .mrow__name {
    flex: none;
    font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-sans);
    color: var(--ink);
  }
  .mrow__id {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--fs-mono-sm);
    line-height: var(--lh-mono-sm);
    color: var(--ink-3);
  }
  .mrow__owner { color: var(--ink-2); white-space: nowrap; }
  .mrow__num,
  .mrow__date { color: var(--ink-3); text-align: right; white-space: nowrap; }
  .mrow__price { color: var(--ink-2); }

  /* 平板：去掉输出与发布日期，ID 让位给名称 */
  @media (max-width: 1024px) {
    .mrow { grid-template-columns: minmax(0, 1fr) 10ch 8ch 22ch; column-gap: var(--sp-4); }
    .mrow__out,
    .mrow__date,
    .mrow__id { display: none; }
  }
  /* 手机：名称一行，研发方 · 上下文 · 价格一行 */
  @media (max-width: 640px) {
    .mrow {
      grid-template-columns: auto auto minmax(0, 1fr);
      column-gap: var(--sp-3);
      row-gap: var(--sp-1);
    }
    .mrow__main { grid-column: 1 / -1; }
    .mrow__num { text-align: left; }
    .mrow__price { text-align: right; }
  }
</style>
