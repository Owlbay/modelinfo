---
/**
 * 模型列表行。默认显示 6 列（名称 · 模型厂商 · 上下文 · 输出 · 价格 · 发布）；
 * 外层 .models--full 时展开为全部字段，列宽由 ModelsView 的表格网格统一决定。列定义与表头 ModelsHead 一致，骨架见 .list-row。
 */
import { formatPrice, formatTokens, modelKind, ownerName, type Model } from '../lib/models';
import { dict, localePath, type Lang } from '../i18n';
import VendorLogo from './VendorLogo.astro';
import Modalities from './Modalities.astro';

interface Props {
  lang: Lang;
  model: Model;
}
const { lang, model: m } = Astro.props;
const d = dict(lang);
const p = m.pricing;
const list = (v: string[]) => (v.length ? v.join(' · ') : '—');
// 非 Token 计价时在价格后标注单位
const unit = p && p.unit !== '1M_tokens' ? ` / ${d.units[p.unit]}` : '';
const reasoning =
  m.reasoning.supported === null ? '—' : m.reasoning.supported ? list(m.reasoning.efforts) === '—' ? d.model.yes : list(m.reasoning.efforts) : d.model.no;
const cache = p && (p.cache_read !== null || p.cache_write !== null) ? `${formatPrice(p.cache_read, p.currency)} / ${formatPrice(p.cache_write, p.currency)}` : '—';
---

<a class="list-row mrow" href={localePath(lang, `/models/${m.id}/`)} data-model data-owner={m.owned_by} data-kind={modelKind(m)} data-hay={[m.id, m.name, m.owned_by, ownerName(m.owned_by), ...m.aliases].join(' ').toLowerCase()}>
  <span class="mrow__main">
    <span class="mrow__name">{m.name}</span>
    <span class="mrow__id">{m.id}</span>
  </span>
  <span class="mrow__owner"><VendorLogo id={m.owned_by} size={14} /><span>{ownerName(m.owned_by)}</span></span>
  <span class="mrow__x">{d.models.kinds[modelKind(m)]}</span>
  <span class="mrow__x">{list(m.api.types)}</span>
  <span class="mrow__num">{formatTokens(m.limits.context)}</span>
  <span class="mrow__num mrow__x">{formatTokens(m.limits.input)}</span>
  <span class="mrow__num mrow__out">{formatTokens(m.limits.output)}</span>
  <span class="mrow__x"><Modalities lang={lang} items={m.modalities.input} /></span>
  <span class="mrow__x"><Modalities lang={lang} items={m.modalities.output} /></span>
  <span class="mrow__x">{reasoning}</span>
  <span class="mrow__num mrow__price">
    {p ? `${formatPrice(p.input, p.currency)} / ${formatPrice(p.output, p.currency)}${unit}` : '—'}
  </span>
  <span class="mrow__num mrow__x">{cache}</span>
  <span class="mrow__x">{list(m.features)}</span>
  <span class="mrow__x">{d.model.status[m.info.status]}</span>
  <span class="mrow__date">{m.info.release_date ?? '—'}</span>
  <span class="mrow__date mrow__x">{m.info.knowledge_cutoff ?? '—'}</span>
</a>

<style>
  /* 默认 6 列，按比例分配宽度；表头见 ModelsView，断点与之一致 */
  .mrow {
    grid-template-columns: minmax(0, 4fr) minmax(0, 1.6fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 2fr) minmax(0, 1.1fr);
    column-gap: var(--sp-5);
    color: var(--ink);
  }
  .mrow__x { display: none; }
  .mrow__main {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    min-width: 0;
  }
  .mrow__name {
    /* 名称优先占位，ID 先省略；名称超过整列时自身也省略，不撑宽行 */
    flex: none;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 400 var(--fs-body-lg) / var(--lh-body-lg) var(--font-sans);
    color: var(--ink);
  }
  .mrow__id {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--fs-mono-sm);
    line-height: var(--lh-mono-sm);
    color: var(--ink-3);
  }
  .mrow__owner {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-width: 0;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .mrow__owner > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .mrow__num,
  .mrow__date { color: var(--ink-3); text-align: right; white-space: nowrap; }
  .mrow__price { color: var(--ink-2); }

  /* 展开：全部字段。行作为表格的 subgrid，列宽按全表内容统一，单元格不换行，行高一致 */
  :global(.models--full) .mrow {
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    column-gap: normal;
  }
  :global(.models--full) .mrow__x { display: block; }
  :global(.models--full) .mrow > span { white-space: nowrap; }
  :global(.models--full) .mrow > span:not(.mrow__num):not(.mrow__date) { color: var(--ink-2); }
  /* 固定列：撑满整行（含行内边距），右侧阴影盖住列间距，横向滚动时下层内容不外露；悬停时随行变色 */
  :global(.models--full) .mrow { --row-pad: 0px; }
  :global(.models--full) .mrow .mrow__main {
    position: sticky;
    left: 0;
    z-index: 1;
    align-self: stretch;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    margin-block: calc(-1 * var(--sp-3));
    padding-block: var(--sp-3);
    background: var(--bg);
    box-shadow: var(--sp-5) 0 0 var(--bg);
  }
  @media (hover: hover) {
    :global(.models--full) .mrow:hover .mrow__main {
      background: var(--hover-row-solid);
      box-shadow: var(--sp-5) 0 0 var(--hover-row-solid);
    }
  }
  :global(.models--full) .mrow .mrow__name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; color: var(--ink); }
  :global(.models--full) .mrow .mrow__id { max-width: 100%; }

  /* 平板（默认视图）：去掉输出与发布日期，ID 让位给名称 */
  @media (max-width: 1024px) {
    .mrow { grid-template-columns: minmax(0, 3fr) minmax(0, 1.6fr) minmax(0, 0.9fr) minmax(0, 2fr); column-gap: var(--sp-4); }
    .mrow__out,
    .mrow__date,
    .mrow__id { display: none; }
    :global(.models--full) .mrow__out,
    :global(.models--full) .mrow__date,
    :global(.models--full) .mrow__id { display: block; }
  }
  /* 手机（默认视图）：名称一行，模型厂商 · 上下文 · 价格一行 */
  @media (max-width: 640px) {
    .mrow {
      grid-template-columns: auto auto minmax(0, 1fr);
      column-gap: var(--sp-3);
      row-gap: var(--sp-1);
    }
    .mrow__main { grid-column: 1 / -1; }
    .mrow__num { text-align: left; }
    /* 带单位的价格较长，窄屏允许换行，不撑宽行 */
    .mrow__price { text-align: right; white-space: normal; overflow-wrap: anywhere; }
    :global(.models--full) .mrow__main { grid-column: auto; }
  }
</style>
