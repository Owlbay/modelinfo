---
/** 页脚：数据来源说明与构建日期（东八区） */
import { dict, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang);
const built = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__id">
      <p>ModelInfo · {t.footer.tagline}</p>
      <p>{t.footer.note}</p>
    </div>
    <ul class="site-footer__links" role="list">
      <li><a href={localePath(lang, '/docs/')}>{t.nav.docs}</a></li>
      <li><a href="https://github.com/Owlbay/modelinfo">GitHub</a></li>
    </ul>
    <p class="site-footer__built corner">{t.footer.built(built)}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: var(--sp-6);
    padding-bottom: max(var(--sp-6), env(safe-area-inset-bottom));
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
  }
  .site-footer__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .site-footer__id { color: var(--ink-3); }
  .site-footer__links {
    display: flex;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links { flex: none; }
  .site-footer__links a {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    margin-block: calc((var(--lh-body-sm) - var(--control-h)) / 2);
    color: var(--ink-2);
  }
  .site-footer__links a:hover { color: var(--ink); }
  .site-footer__built { white-space: nowrap; }
  /* 平板与手机：说明、链接、构建日期纵向排列 */
  @media (max-width: 1024px) {
    .site-footer__inner { flex-direction: column; gap: var(--sp-3); }
  }
</style>
