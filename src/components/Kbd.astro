---
/** 快捷键提示：全站统一为等宽方括号写法 [B]，只作提示，不进入读屏 */
interface Props {
  k: string;
  class?: string;
}
const { k, class: className } = Astro.props;
---

<kbd class:list={['kbd', className]} aria-hidden="true">[{k}]</kbd>

<style>
  .kbd {
    font: 400 var(--fs-mono) / var(--lh-mono) var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    background: none;
    border: 0;
    padding: 0;
  }
  /* 触屏设备没有键盘快捷键，不显示提示 */
  @media (pointer: coarse) {
    .kbd { display: none; }
  }
</style>
