---
/**
 * 站内图标：统一 24 网格、1.5 描边、无填充。
 * 均为本项目自绘几何形。
 */
import { PATHS, type IconName as Name } from '../lib/icons';

interface Props {
  name: Name;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 16, class: className, label } = Astro.props;

const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={1.5 * (24 / size)}
  stroke-linecap="square"
  stroke-linejoin="miter"
  focusable="false"
  {...a11y}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>

<style>
  .icon { flex: none; }
</style>
