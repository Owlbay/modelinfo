---
/**
 * 输入 / 输出模态：每种模态一个小方框图标，名称作为提示与无障碍文本；labeled 时在图标后显示名称（详情页）。
 * sprite 为 true 时引用页面中 Sprites 组件的 symbol（长列表用）。
 */
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  items: string[];
  labeled?: boolean;
  sprite?: boolean;
}
const { lang, items, labeled = false, sprite = false } = Astro.props;
const names = dict(lang).models.modalityNames as Record<string, string>;
const KNOWN = ['text', 'image', 'video', 'audio', 'document', 'embedding', 'score', '3d'] as const;
type Known = (typeof KNOWN)[number];
const isKnown = (v: string): v is Known => (KNOWN as readonly string[]).includes(v);
---

{
  items.length ? (
    <span class:list={['mods', { 'mods--labeled': labeled }]}>
      {items.map((v) =>
        isKnown(v) ? (
          labeled ? (
            <span class="mods__entry">
              <span class="mods__item">
                <Icon name={`mod-${v}`} size={12} />
              </span>
              {names[v]}
            </span>
          ) : (
            <span class="mods__item" title={names[v]}>
              {sprite ? (
                <svg class="icon" width="12" height="12" role="img" aria-label={names[v]}>
                  <use href={`#i-mod-${v}`} />
                </svg>
              ) : (
                <Icon name={`mod-${v}`} size={12} label={names[v]} />
              )}
            </span>
          )
        ) : (
          <span class="mods__item mods__item--text" title={v}>{v}</span>
        ),
      )}
    </span>
  ) : (
    '—'
  )
}

<style>
  .mods { display: inline-flex; gap: var(--sp-1); vertical-align: middle; }
  .mods__item {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .mods--labeled { flex-wrap: wrap; gap: var(--sp-2) var(--sp-4); }
  .mods__entry { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .mods__item--text { width: auto; padding: 0 var(--sp-1); font-size: var(--fs-mono-sm); }
</style>
