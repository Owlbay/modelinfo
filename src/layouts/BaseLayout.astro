---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/motion.css';
import type { PageId } from '../lib/nav';
import { basePath, DEFAULT_LANG, dict, locale, localePath, LOCALES, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: PageId;
  /** 页面标题；首页为空 */
  title?: string;
  description?: string;
}

const { lang, page, title, description } = Astro.props;
const t = dict(lang);
const fullTitle = title ? `${title} · ModelInfo` : 'ModelInfo';
const site = Astro.site ?? Astro.url;
const base = basePath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang={locale(lang).htmlLang} data-scheme="dark" data-page={page} data-prefix={localePath(lang, "")}>
  <head>
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('modelinfo.scheme');
          if (s !== 'dark' && s !== 'light') s = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.scheme = s;
        } catch (e) {}
      })();
    </script>
    {
      lang === DEFAULT_LANG && (
        <script is:inline define:vars={{ langs: LOCALES.map((l) => l.code).filter((c) => c !== DEFAULT_LANG) }}>
          try {
            var l = localStorage.getItem('modelinfo.lang');
            if (l && langs.indexOf(l) >= 0) location.replace('/' + l + location.pathname + location.search + location.hash);
          } catch (e) {}
        </script>
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l.htmlLang} href={new URL(localePath(l.code, base), site).href} />)}
    <meta name="theme-color" content="#141413" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body class={`page-${page}`}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
    <script>
      import { initTheme } from '../scripts/theme';
      import { installShortcuts } from '../scripts/shortcuts';
      import { installCopy } from '../scripts/copy';
      initTheme();
      installShortcuts();
      installCopy();
    </script>
  </body>
</html>
