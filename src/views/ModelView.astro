---
/** 模型详情：规格分组、Provider 调用方式（可复制地址）、标准 JSON 与官方来源。 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionFrame from '../components/SectionFrame.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Endpoint from '../components/Endpoint.astro';
import Icon from '../components/Icon.astro';
import VendorLogo from '../components/VendorLogo.astro';
import Modalities from '../components/Modalities.astro';
import Stats from '../components/Stats.astro';
import { correctionUrl } from '../lib/nav';
import { formatPrice, formatTokens, ownerName, toPublic, type Model } from '../lib/models';
import { dict, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  model: Model;
}
const { lang, model: m } = Astro.props;
const t = dict(lang).model;
const tm = dict(lang).models;
const p = m.pricing;
const f = t.fields;
const g = t.groups;
const unit = p ? dict(lang).units[p.unit] : '';

/** 行值：文本（null 为未知）、模态图标、或小方框标签（接口类型、能力） */
type Value = { kind: 'text'; v: string | null } | { kind: 'mods' | 'tags'; v: string[] };
const text = (v: string | null): Value => ({ kind: 'text', v: v === '—' ? null : v });
const isEmpty = (x: Value) => (x.kind === 'text' ? x.v === null : x.v.length === 0);
const yesNo = (v: boolean | null) => (v === null ? null : v ? t.yes : t.no);

const keyStats = [
  { label: t.keyStats.context, value: formatTokens(m.limits.context) },
  { label: t.keyStats.output, value: formatTokens(m.limits.output) },
  { label: t.keyStats.inputPrice, value: p ? formatPrice(p.input, p.currency) : '—', unit: p && p.input !== null ? `/ ${unit}` : undefined },
  { label: t.keyStats.outputPrice, value: p ? formatPrice(p.output, p.currency) : '—', unit: p && p.output !== null ? `/ ${unit}` : undefined },
  { label: t.keyStats.released, value: m.info.release_date ?? '—' },
];

// 顺序按桌面 4 列排：第一行 上下文(3) 价格(4) 输入输出(2) API(1)，第二行 思考(1–2) 源信息(3) 能力(1)，行高接近
const groups: Array<{ title: string; rows: Array<[string, Value]> }> = [
  {
    title: g.limits,
    rows: [
      [f.context, text(formatTokens(m.limits.context))],
      [f.maxInput, text(formatTokens(m.limits.input))],
      [f.maxOutput, text(formatTokens(m.limits.output))],
    ],
  },
  {
    title: p ? `${g.pricing} · ${t.perUnit(p.currency, unit)}` : g.pricing,
    rows: [
      [f.input, text(p ? formatPrice(p.input, p.currency) : null)],
      [f.output, text(p ? formatPrice(p.output, p.currency) : null)],
      [f.cacheRead, text(p ? formatPrice(p.cache_read, p.currency) : null)],
      [f.cacheWrite, text(p ? formatPrice(p.cache_write, p.currency) : null)],
    ],
  },
  {
    title: g.modalities,
    rows: [
      [f.input, { kind: 'mods', v: m.modalities.input }],
      [f.output, { kind: 'mods', v: m.modalities.output }],
    ],
  },
  { title: g.api, rows: [[f.types, { kind: 'tags', v: m.api.types }]] },
  {
    title: g.reasoning,
    rows: [
      [f.supported, text(yesNo(m.reasoning.supported))],
      // 明确不支持思考时不显示等级
      ...(m.reasoning.supported === false ? [] : [[f.efforts, { kind: 'tags', v: m.reasoning.efforts }] as [string, Value]]),
    ],
  },
  {
    title: g.info,
    rows: [
      [f.status, text(t.status[m.info.status])],
      [f.released, text(m.info.release_date)],
      [f.cutoff, text(m.info.knowledge_cutoff)],
    ],
  },
  { title: g.features, rows: [[f.features, { kind: 'tags', v: m.features }]] },
];
const json = JSON.stringify(toPublic(m), null, 2);
const verified = tm.verified(m.info.verified_at ?? '—');
---

<BaseLayout lang={lang} page="model" title={m.name} description={m.info.description ?? undefined}>
  <TopNav lang={lang} page="model" />
  <main id="main" class="page detail">
    <a class="detail__back" href={localePath(lang, '/models/')}><Icon name="arrow-left" size={12} />{t.back}</a>
    <PageHeader title={m.name} intro={m.info.description ?? undefined}>
      <span class="detail__meta mono">
        <span class="detail__vendor"><VendorLogo id={m.owned_by} size={14} />{ownerName(m.owned_by)}</span>
        <span>{m.id}</span>{m.info.release_date && <span>{m.info.release_date}</span>}
        <a class="detail__report" href={correctionUrl(m.id)} target="_blank" rel="noopener">{t.report}<Icon name="arrow-up-right" size={12} /></a>
      </span>
    </PageHeader>

    <SectionFrame id="spec" title={t.specs} source={tm.source} stamp={verified}>
      <Stats items={keyStats} />
      <div class="spec">
        {
          groups.map((grp) => (
            <section class="spec__group">
              <h3 class="spec__title">{grp.title}</h3>
              <dl class="spec__list">
                {grp.rows.every(([, v]) => isEmpty(v)) ? (
                  <div class="spec__row spec__row--none">
                    <dd>{t.notPublished}</dd>
                  </div>
                ) : (
                  grp.rows.map(([k, v]) => (
                    <div class="spec__row">
                      <dt>{k}</dt>
                      <dd>
                        {isEmpty(v) ? (
                          '—'
                        ) : v.kind === 'text' ? (
                          v.v
                        ) : v.kind === 'mods' ? (
                          <Modalities lang={lang} items={v.v} labeled />
                        ) : (
                          <span class="tags">
                            {v.v.map((x) => (
                              <span class="tag">{x}</span>
                            ))}
                          </span>
                        )}
                      </dd>
                    </div>
                  ))
                )}
              </dl>
            </section>
          ))
        }
      </div>
    </SectionFrame>

    {
      m.providers.length > 0 && (
        <SectionFrame id="providers" title={t.call} count={t.providers(m.providers.length)}>
          {m.providers.map((pv) => (
            <div class="prov">
              <p class="prov__head mono">
                <span class="prov__id">{pv.id}</span>
                <span>model = {pv.model}</span>
                {pv.reasoning_param && <span>reasoning = {pv.reasoning_param}</span>}
              </p>
              <div class="prov__eps">
                {Object.entries(pv.endpoints).map(([type, ep]) => {
                  const [method, path] = ep.split(' ');
                  return (
                    <div class="prov__ep">
                      <span class="prov__type mono">{type}</span>
                      <Endpoint lang={lang} method={method!} url={pv.base_url + path} />
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </SectionFrame>
      )
    }

    <SectionFrame id="json" title={t.json} count={t.standard}>
      <CodeBlock lang={lang} label={`${m.id}.json`} code={json} />
    </SectionFrame>

    <SectionFrame id="sources" title={t.sources} count={String(m.sources.length)}>
      {
        m.sources.map((s) => (
          <a class="list-row src" href={s.url} rel="noopener">
            <span class="src__title">{s.title}</span>
            <span class="src__host">{new URL(s.url).host}</span>
            <span class="src__date">{s.retrieved_at}</span>
          </a>
        ))
      }
    </SectionFrame>
  </main>
</BaseLayout>

<style>
  .detail { padding-bottom: var(--sp-8); }
  .detail__back {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--control-h);
    margin-top: var(--sp-5);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--ink-2);
    text-decoration: none;
  }
  .detail__back:hover { color: var(--ink); }
  .detail :global(.phead) { padding-top: var(--sp-4); }
  .detail__vendor { display: inline-flex; align-items: center; gap: var(--sp-2); color: var(--ink-2); }
  .detail__report {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    margin-left: auto;
    font-family: var(--font-sans);
    color: var(--ink-2);
    text-decoration: none;
  }
  .detail__report:hover { color: var(--ink); }
  .detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    font-size: var(--fs-mono);
    line-height: var(--lh-mono);
    color: var(--ink-3);
  }

  /* 规格分组：桌面 4 列、平板 2 列、手机 1 列 */
  .spec {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-6);
    margin-top: var(--sp-6);
  }
  .spec__group { min-width: 0; }
  .spec__title {
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--line);
    font: 500 var(--fs-body) / var(--lh-body) var(--font-sans);
    color: var(--ink);
  }
  /* 标签列按本组最长标签取宽，各行用 subgrid 共享列线 */
  .spec__list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--sp-4);
    margin: 0;
  }
  .spec__row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .spec__row dt {
    font: 400 var(--fs-body-sm) / var(--lh-body-sm) var(--font-sans);
    color: var(--ink-3);
  }
  .spec__row dd {
    min-width: 0;
    margin: 0;
    font: 400 var(--fs-mono) / var(--lh-mono) var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .spec__row--none dd {
    grid-column: 1 / -1;
    font: 400 var(--fs-body-sm) / var(--lh-body-sm) var(--font-sans);
    color: var(--ink-3);
  }
  /* 接口类型、能力、思考等级：小方框标签，与模态图标同一描边 */
  .tags { display: flex; flex-wrap: wrap; gap: var(--sp-1); }
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 var(--sp-1);
    border: 1px solid var(--line-strong);
    font-size: var(--fs-mono-sm);
    line-height: var(--lh-mono-sm);
    color: var(--ink-2);
  }

  .prov + .prov { margin-top: var(--sp-6); }
  .prov__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    font-size: var(--fs-mono);
    line-height: var(--lh-mono);
    color: var(--ink-3);
  }
  /* 参数路径很长时允许断行，避免手机上撑出页面 */
  .prov__head > span { min-width: 0; overflow-wrap: anywhere; }
  .prov__id { color: var(--ink); }
  .prov__eps {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .prov__ep {
    display: grid;
    grid-template-columns: 12ch minmax(0, 1fr);
    align-items: center;
    column-gap: var(--sp-4);
  }
  .prov__type {
    font-size: var(--fs-mono);
    line-height: var(--lh-mono);
    color: var(--ink-3);
  }


  .src {
    grid-template-columns: minmax(0, 1fr) auto 10ch;
    column-gap: var(--sp-5);
  }
  .src__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 400 var(--fs-body) / var(--lh-body) var(--font-sans);
    color: var(--ink);
  }
  .src__host,
  .src__date { color: var(--ink-3); white-space: nowrap; }

  @media (max-width: 1024px) {
    .spec { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .spec { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); margin-top: var(--sp-5); }
    .prov__ep { grid-template-columns: minmax(0, 1fr); row-gap: var(--sp-1); }
    .src { grid-template-columns: minmax(0, 1fr) auto; }
    .src__host { display: none; }
  }
</style>
