---
/** 模型列表：按模型厂商、类型筛选并支持关键词过滤，筛选状态同步到 URL。 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionFrame from '../components/SectionFrame.astro';
import FilterMenu from '../components/FilterMenu.astro';
import ModelRow from '../components/ModelRow.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import { getModels, KINDS, latestVerified, modelKind, ownerName } from '../lib/models';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang).models;

const models = await getModels();
const count = <T,>(list: T[], key: (x: T) => string) => list.reduce((acc, x) => acc.set(key(x), (acc.get(key(x)) ?? 0) + 1), new Map<string, number>());
const ownerCounts = [...count(models, (m) => m.owned_by)].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const kindCounts = count(models, modelKind);
const ownerOptions = [
  { value: '', label: t.all, count: models.length },
  ...ownerCounts.map(([o, n]) => ({ value: o, label: ownerName(o), count: n, vendor: o })),
];
const kindOptions = [
  { value: '', label: t.all, count: models.length },
  ...KINDS.filter((k) => kindCounts.has(k)).map((k) => ({ value: k as string, label: t.kinds[k], count: kindCounts.get(k) ?? 0 })),
];
const verifiedAt = latestVerified(models) ?? '—';
---

<BaseLayout lang={lang} page="models" title={t.title}>
  <TopNav lang={lang} page="models" />
  <main id="main" class="page models">
    <PageHeader title={t.title} intro={t.intro}>
      <Stats
        slot="aside"
        inline
        items={[
          { label: t.stats.models, value: String(models.length) },
          { label: t.stats.vendors, value: String(ownerCounts.length) },
          { label: t.stats.verified, value: verifiedAt },
        ]}
      />
    </PageHeader>

    <SectionFrame id="list" title={t.frame} titleHidden source={t.source} stamp={t.verified(verifiedAt)}>
      <div class="tbar" role="search" data-vt-toolbar aria-label={t.toolbarAria}>
        <label class="tbar__search">
          <Icon name="search" size={16} />
          <input type="search" data-filter-q placeholder={t.searchPlaceholder} aria-label={t.searchAria} autocomplete="off" spellcheck="false" />
        </label>
        <FilterMenu name="kind" label={t.kindLabel} options={kindOptions} />
        <FilterMenu name="owner" label={t.cols.vendor} options={ownerOptions} searchPlaceholder={t.vendorSearch} />
        <div class="tbar__end">
          <span class="tbar__count mono" aria-live="polite"><span data-shown>{models.length}</span> {t.total(models.length)}</span>
          <button type="button" class="models__toggle" data-view-toggle aria-pressed="false">
            <span data-view-label-off>{t.showAll}</span><span data-view-label-on hidden>{t.showLess}</span>
          </button>
        </div>
      </div>
      <div class="models__table" data-models-table>
      <div class="models__head mono" aria-hidden="true">
        <span class="head__main">{t.cols.model}</span><span>{t.cols.vendor}</span>
        <span class="hx">{t.cols.kind}</span><span class="hx">{t.cols.api}</span>
        <span class="head__r">{t.cols.context}</span><span class="hx head__r">{t.cols.input}</span><span class="head__out head__r">{t.cols.output}</span>
        <span class="hx">{t.cols.modIn}</span><span class="hx">{t.cols.modOut}</span><span class="hx">{t.cols.reasoning}</span>
        <span class="head__r">{t.cols.price}</span><span class="hx head__r">{t.cols.cache}</span>
        <span class="hx">{t.cols.features}</span><span class="hx">{t.cols.status}</span>
        <span class="head__date head__r">{t.cols.released}</span><span class="hx head__r">{t.cols.cutoff}</span>
      </div>
      <div data-vt-list>
        {models.map((m) => <ModelRow lang={lang} model={m} />)}
        <p class="models__empty" data-empty hidden>{t.empty}</p>
      </div>
      </div>
    </SectionFrame>

  </main>
</BaseLayout>

<script>
  const list = document.querySelector<HTMLElement>('[data-vt-list]')!;
  const rows = [...list.querySelectorAll<HTMLElement>('[data-model]')];
  const empty = list.querySelector<HTMLElement>('[data-empty]')!;
  const shownEl = document.querySelector<HTMLElement>('[data-shown]')!;
  const input = document.querySelector<HTMLInputElement>('[data-filter-q]')!;
  const params = new URLSearchParams(location.search);
  const state = { q: params.get('q') ?? '', owner: params.get('owner') ?? '', kind: params.get('kind') ?? '' };
  // 展开全部信息：网址参数 view=full 优先，其次记住上次选择
  const main = document.querySelector<HTMLElement>('main.models')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-view-toggle]')!;
  let full = params.has('view') ? params.get('view') === 'full' : localStorage.getItem('modelinfo.view') === 'full';
  function applyView() {
    main.classList.toggle('models--full', full);
    toggle.setAttribute('aria-pressed', String(full));
    toggle.querySelector<HTMLElement>('[data-view-label-off]')!.hidden = full;
    toggle.querySelector<HTMLElement>('[data-view-label-on]')!.hidden = !full;
  }
  toggle.addEventListener('click', () => {
    full = !full;
    try {
      localStorage.setItem('modelinfo.view', full ? 'full' : 'compact');
    } catch {
      /* 隐私模式忽略 */
    }
    applyView();
    apply();
  });
  applyView();
  input.value = state.q;

  function apply() {
    const terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const r of rows) {
      const hit =
        (!state.owner || r.dataset.owner === state.owner) &&
        (!state.kind || r.dataset.kind === state.kind) &&
        terms.every((t) => r.dataset.hay!.includes(t));
      r.hidden = !hit;
      if (hit) shown++;
    }
    empty.hidden = shown > 0;
    shownEl.textContent = String(shown);
    for (const menu of document.querySelectorAll<HTMLElement>('[data-filter-menu]')) {
      const v = state[menu.dataset.filterMenu as 'owner' | 'kind'];
      let label = '';
      menu.querySelectorAll<HTMLButtonElement>('[data-filter-option]').forEach((b) => {
        const on = b.dataset.value === v;
        b.setAttribute('aria-pressed', String(on));
        if (on) label = b.dataset.label ?? '';
      });
      menu.querySelector('[data-filter-current]')!.textContent = label;
    }
    // 筛选状态写入 URL，便于分享与返回
    const url = new URL(location.href);
    for (const [k, v] of Object.entries(state)) v ? url.searchParams.set(k, v) : url.searchParams.delete(k);
    full ? url.searchParams.set('view', 'full') : url.searchParams.delete('view');
    history.replaceState(null, '', url);
  }

  const transition = (run: () => void) => {
    if (!document.startViewTransition) return run();
    document.documentElement.dataset.vt = 'list';
    document.startViewTransition(run).finished.finally(() => delete document.documentElement.dataset.vt);
  };

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const b = target?.closest<HTMLButtonElement>('[data-filter-option]');
    if (b) {
      state[b.dataset.name as 'owner' | 'kind'] = b.dataset.value ?? '';
      (b.closest('details') as HTMLDetailsElement).open = false;
      transition(apply);
      return;
    }
    // 点击菜单外部时收起
    for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-filter-menu][open]')) {
      if (!d.contains(target)) d.open = false;
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-filter-menu][open]')) d.open = false;
  });
  // 菜单内搜索：按名称过滤厂商
  for (const box of document.querySelectorAll<HTMLInputElement>('[data-filter-search]')) {
    box.addEventListener('input', () => {
      const q = box.value.trim().toLowerCase();
      box.closest('details')!.querySelectorAll<HTMLElement>('[data-filter-option]').forEach((o) => {
        o.hidden = !!q && !o.dataset.hay!.includes(q);
      });
    });
  }
  input.addEventListener('input', () => {
    state.q = input.value.trim();
    apply();
  });
  apply();
</script>

<style>
  .models { padding-bottom: var(--sp-8); }
  /* 列表工具栏：搜索 + 类型 + 模型厂商 + 计数与视图切换，一行铺满。顶栏不固定，工具栏滚动时吸在视口顶部；
     z-index 20 高于全字段视图的固定列（1），下拉面板（50）在工具栏的层叠上下文内，因此盖住下方表格 */
  .tbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin: calc(-1 * var(--sp-3)) calc(-1 * var(--page-pad)) var(--sp-4);
    padding: var(--sp-3) var(--page-pad);
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg);
  }
  .tbar__search {
    display: flex;
    flex: 1 1 280px;
    align-items: center;
    gap: var(--sp-3);
    min-width: 0;
    height: var(--control-h);
    padding: 0 var(--sp-3);
    border: 1px solid var(--line-strong);
    color: var(--ink-3);
    transition: border-color var(--dur-1) var(--ease-out);
  }
  .tbar__search:focus-within { border-color: var(--accent-ui); }
  .tbar__search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    font: 400 var(--fs-body) / var(--lh-body) var(--font-sans);
    color: var(--ink);
    outline: none;
  }
  .tbar__search input:focus-visible { outline: none; }
  .tbar__search input::-webkit-search-cancel-button { display: none; }
  .tbar__end {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-left: auto;
    padding-left: var(--sp-3);
  }
  .tbar__count {
    font-size: var(--fs-mono);
    line-height: var(--lh-mono);
    color: var(--ink-3);
    white-space: nowrap;
  }
  .models__toggle {
    display: inline-flex;
    align-items: center;
    height: var(--control-h);
    padding: 0 var(--sp-3);
    border: 1px solid var(--line-strong);
    font: 400 var(--fs-body-sm) / var(--lh-body-sm) var(--font-sans);
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .models__toggle:hover { color: var(--ink); background: var(--hover-row); }
  .models__toggle[aria-pressed='true'] { background: var(--selected-bg); border-color: var(--selected-bg); color: var(--selected-ink); }
  /* 表头与 ModelRow 同列定义、同字号 */
  .models__head {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 1.6fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 2fr) minmax(0, 1.1fr);
    column-gap: var(--sp-5);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-mono);
    line-height: var(--lh-mono);
    color: var(--ink-3);
  }
  .models__head .hx { display: none; }
  .head__r { text-align: right; }
  /* 展开：横向滚动，表头与首列固定 */
  .models__table { min-width: 0; max-width: 100%; }
  .models--full .models__table { overflow-x: auto; overscroll-behavior-x: contain; }
  /* 列宽按全表最宽内容取宽，空余分给各列；固定的模型列定宽（窄屏按视口比例），给后续列留出位置。表头与各行用 subgrid 共享列线 */
  .models--full .models__table {
    display: grid;
    grid-template-columns: min(20rem, 42vw) repeat(15, minmax(max-content, auto));
    column-gap: var(--sp-5);
  }
  .models--full [data-vt-list] { display: contents; }
  .models--full .models__empty { grid-column: 1 / -1; }
  .models--full .models__head {
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    white-space: nowrap;
    column-gap: normal;
  }
  .models--full .models__head .hx,
  .models--full .models__head .head__out,
  .models--full .models__head .head__date { display: block; }
  .models--full .head__main {
    position: sticky;
    left: 0;
    z-index: 1;
    align-self: stretch;
    margin-bottom: calc(-1 * var(--sp-2));
    padding-bottom: var(--sp-2);
    background: var(--bg);
    box-shadow: var(--sp-5) 0 0 var(--bg);
  }
  .models__empty {
    padding: var(--sp-5) 0;
    color: var(--ink-3);
  }
  @media (max-width: 1024px) {
    .models__head { grid-template-columns: minmax(0, 3fr) minmax(0, 1.6fr) minmax(0, 0.9fr) minmax(0, 2fr); column-gap: var(--sp-4); }
    .head__out,
    .head__date { display: none; }
  }
  @media (max-width: 640px) {
    .models:not(.models--full) .models__head { display: none; }
    /* 手机：工具栏占三行，不吸顶，把屏幕留给列表 */
    .tbar { position: static; padding-top: 0; margin-top: 0; }
    .tbar__search { flex-basis: 100%; }
    .tbar__end { width: 100%; justify-content: space-between; padding-left: 0; }
  }
</style>
