// 纯静态：Cloudflare Workers Static Assets，无 Worker 脚本、无存储绑定。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelinfo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // 自定义域名（托管在 Cloudflare），首次部署时自动创建 DNS 记录与证书
  "routes": [{ "pattern": "modelinfo.dev", "custom_domain": true }]
}
