// 纯静态部署：Workers Static Assets，无 Worker 脚本、无存储绑定。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelinfo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // 绑定自定义域名（域名需托管在 Cloudflare）：取消注释并替换为你的域名
  // "routes": [{ "pattern": "modelinfo.example.com", "custom_domain": true }]
}
